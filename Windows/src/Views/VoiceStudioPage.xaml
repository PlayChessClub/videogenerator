<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ClipForgeAI.Win.Views.VoiceStudioPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer Padding="24">
        <StackPanel Spacing="20">
            <TextBlock Text="声音工坊" FontSize="28" FontWeight="SemiBold"/>

            <!-- 声音克隆 -->
            <Expander Header="声音克隆(上传参考音频,获得专属 voice_id)" IsExpanded="True">
                <StackPanel Spacing="12" Padding="0,12,0,0">
                    <TextBox x:Name="TxtPrefix" Header="音色前缀(英文,如 myvoice)"
                             PlaceholderText="myvoice"
                             Text="myvoice"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="BtnPickCloneAudio" Content="选择参考音频…" Click="OnPickCloneAudio"/>
                        <TextBlock x:Name="TxtClonePath" VerticalAlignment="Center" Opacity="0.6"/>
                    </StackPanel>
                    <Button x:Name="BtnSubmitClone" Content="开始克隆"
                            Style="{StaticResource AccentButtonStyle}"
                            Click="OnSubmitClone"/>
                    <TextBlock x:Name="TxtCloneStatus" Opacity="0.8" TextWrapping="Wrap"/>
                </StackPanel>
            </Expander>

            <!-- 音色列表 -->
            <Expander Header="已有音色(下拉选择 / 刷新)" IsExpanded="True">
                <StackPanel Spacing="12" Padding="0,12,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ComboBox x:Name="CmbVoices" PlaceholderText="先克隆一个音色" MinWidth="280"/>
                        <Button Content="刷新" Click="OnRefreshVoices"/>
                    </StackPanel>
                </StackPanel>
            </Expander>

            <!-- TTS 合成 -->
            <Expander Header="语音合成(选音色 + 文本 + 调参)" IsExpanded="True">
                <StackPanel Spacing="12" Padding="0,12,0,0">
                    <TextBox x:Name="TxtTtsText" Header="要合成的文本"
                             PlaceholderText="请输入要朗读的文字…"
                             AcceptsReturn="True" TextWrapping="Wrap" MinHeight="100"/>
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <StackPanel Spacing="4" MinWidth="160">
                            <TextBlock Text="音量(0~200)"/>
                            <Slider x:Name="SldVolume" Minimum="0" Maximum="200" Value="0"/>
                        </StackPanel>
                        <StackPanel Spacing="4" MinWidth="160">
                            <TextBlock Text="语速(-50~100)"/>
                            <Slider x:Name="SldRate" Minimum="-50" Maximum="100" Value="0"/>
                        </StackPanel>
                        <StackPanel Spacing="4" MinWidth="160">
                            <TextBlock Text="音调(-50~100)"/>
                            <Slider x:Name="SldPitch" Minimum="-50" Maximum="100" Value="0"/>
                        </StackPanel>
                    </StackPanel>
                    <Button x:Name="BtnSynthesize" Content="开始合成"
                            Style="{StaticResource AccentButtonStyle}"
                            Click="OnSynthesize"/>
                    <ProgressBar x:Name="PbTts" Visibility="Collapsed" Maximum="100"/>
                    <TextBlock x:Name="TxtTtsStatus" Opacity="0.8" TextWrapping="Wrap"/>
                </StackPanel>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</Page>
