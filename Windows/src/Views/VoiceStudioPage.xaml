<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ClipForgeAI.Win.Views.VoiceStudioPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer Padding="24">
        <StackPanel Spacing="20">
            <TextBlock Text="声音工坊" FontSize="28" FontWeight="SemiBold"/>

            <!-- 声音克隆 -->
            <Expander Header="声音克隆(上传参考音频,获得专属 voice_id)" IsExpanded="True">
                <StackPanel Spacing="12" Padding="0,12,0,0">
                    <TextBox x:Name="TxtPrefix" Header="音色前缀(英文,如 myvoice)"
                             PlaceholderText="myvoice"
                             Text="myvoice"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="BtnPickCloneAudio" Content="选择参考音频…" Click="OnPickCloneAudio"/>
                        <TextBlock x:Name="TxtClonePath" VerticalAlignment="Center" Opacity="0.6"/>
                    </StackPanel>
                    <Button x:Name="BtnSubmitClone" Content="开始克隆"
                            Style="{StaticResource AccentButtonStyle}"
                            Click="OnSubmitClone"/>
                    <TextBlock x:Name="TxtCloneStatus" Opacity="0.8" TextWrapping="Wrap"/>
                </StackPanel>
            </Expander>

            <!-- 已有音色 -->
            <Expander Header="已有音色(用于其他工具集成)" IsExpanded="True">
                <StackPanel Spacing="12" Padding="0,12,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ComboBox x:Name="CmbVoices" PlaceholderText="先克隆一个音色" MinWidth="280"/>
                        <Button Content="刷新" Click="OnRefreshVoices"/>
                    </StackPanel>
                    <TextBlock Opacity="0.6" TextWrapping="Wrap">
                        注:TTS 实时合成需要 WebSocket 全双工协议,本版本未集成,请用阿里云 DashScope 控制台或其他客户端。
                    </TextBlock>
                </StackPanel>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</Page>